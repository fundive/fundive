{
  "name": "fundive",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "fundive": "cli/index.js"
  },
  "exports": {
    "./config": "./src/config/define.ts",
    "./vite": "./src/vite/index.ts"
  },
  "files": [
    "cli",
    "!cli/**/*.test.ts",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "tsconfig.sw.json",
    "tsconfig.worker.json",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "public",
    "supabase/config.toml",
    "supabase/migrations",
    "supabase/functions",
    "!supabase/functions/**/*.test.ts",
    "workers/push/src",
    "!workers/push/src/**/*.test.ts",
    "workers/push/wrangler.toml",
    "workers/push/tsconfig.json",
    "wrangler.toml",
    "scripts",
    "fundive.config.ts",
    "template",
    "fundive.config.example.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:all": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "date-fns": "^4.4.0",
    "delaunator": "^5.1.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.107.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "jspdf": "^4.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "@docsearch/react": {
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    },
    "vitepress": {
      "vite": "^6.4.3"
    },
    "undici": "^7.30.0"
  }
}
