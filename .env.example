# FunDive environment — copy to `.env.local` and fill in. NEVER commit it.
# `.env.local` is what the make/npm scripts read. Secrets live only here (and your
# CI secret store), never in the committed repo.
#
# As shipped, this file runs the app against your own machine: copy it, then
# `make start && make dev` and you have a working app with seeded test logins.
# See docs/development.md.
#
# The three local values below are NOT deployable — the production build refuses
# a bundle pointing at 127.0.0.1 or carrying Cloudflare's always-pass test key
# (src/vite/build-env.ts). Replace them, and fill in the sections beneath, when
# you go live: docs/deployment.md.

# ── Client build (baked into the bundle by Vite) ─────────────────────────────
# Local development — works as-is against `make start`. None are secret: the
# anon key is the Supabase CLI's fixed local demo key, and the Turnstile key is
# Cloudflare's published always-pass test key.
VITE_SUPABASE_URL=http://127.0.0.1:64421
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Deploying? Replace the three above with your own:
#   VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
#   VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Optional — push notifications stay off if unset:
VITE_VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
VITE_PUSH_WORKER_URL=https://fundive-push.YOUR-SUBDOMAIN.workers.dev

# ── Supabase (migrations + verify, via the fundive CLI) ──────────────────────
# Not read by local development — `make start` needs none of them.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_POOLER_HOST=aws-x-region.pooler.supabase.com

# ── Cloudflare (deploy, via the fundive CLI / wrangler) ──────────────────────
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# ── Push worker secrets (set via `wrangler secret put` in workers/push) ──────
VAPID_PUBLIC_KEY=your-web-push-vapid-public-key
VAPID_PRIVATE_KEY=your-web-push-vapid-private-key   # server-side only, never in the bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-side only, bypasses RLS
ADMIN_TRIGGER_SECRET=a-random-bearer-token
# Optional:
BROADCAST_WEBHOOK_URL=

# ── Supabase Edge Function secrets (set via `supabase secrets set`) ──────────
# For `supabase functions serve` locally, TURNSTILE_SECRET below is Cloudflare's
# always-pass test secret and the Gmail values need not be real — local mail is
# captured by Mailpit. See docs/development.md § Run the edge functions.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
