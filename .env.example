# FunDive platform development — copy to `.env.local`. Nothing to fill in: as
# shipped it runs the app against the local Supabase stack (`make start && make
# dev`), with seeded test logins. See docs/development.md.
#
# This file is for working on the platform. A shop's own credentials live in
# its deployment repository's .env.local: docs/deployment.md.

# ── Client build (baked into the bundle by Vite) ─────────────────────────────
# None are secret: the anon key is the Supabase CLI's fixed local demo key, and
# the Turnstile key is Cloudflare's published always-pass test key. The
# production build refuses both (src/vite/build-env.ts).
VITE_SUPABASE_URL=http://127.0.0.1:64421
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Edge functions, for `supabase functions serve --env-file .env.local` ─────
# Local mail is captured by Mailpit, so the Gmail values need not be real; the
# Turnstile secret is Cloudflare's always-pass test secret.
# See docs/development.md § Run the edge functions.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
